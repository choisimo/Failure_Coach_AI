# =============================================================
# Failure Coach AI — Frontend Environment Variables
# =============================================================
# Vite 빌드 시 주입되는 환경변수입니다.
# .env.local 파일을 생성하여 아래 값을 덮어씁니다.
# VITE_ 접두사가 붙은 변수만 브라우저에 노출됩니다.
#
# API Key는 Cloudflare Worker(ai-failure.nodove.com)에서 시크릿으로 관리됩니다.
# 프론트엔드에서는 Worker URL만 설정하면 됩니다.
# =============================================================

# Cloudflare Worker 프록시 URL (기본값: https://ai-failure.nodove.com)
# Worker가 OpenAI API 키를 보관하며 /v1/chat/completions 요청을 포워딩합니다.
VITE_AI_GATEWAY_URL=https://ai-failure.nodove.com

# Worker 인증 키 (선택 사항, Worker에서 ALLOWED_ORIGINS로 대부분 처리됨)
VITE_AI_GATEWAY_KEY=
