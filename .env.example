# AI Gateway Configuration
# You can use either the custom AI Gateway or direct OpenAI compatible API

# -------------------------
# OPTION 1: OpenAI Compatible API
# -------------------------
# Base URL for OpenAI compatible endpoint (e.g. https://api.openai.com)
VITE_OPENAI_COMPATIBLE_URL=https://api.openai.com

# API Key for OpenAI compatible API
VITE_OPENAI_API_KEY=sk-your-openai-key

# Model name for OpenAI compatible API (default: gpt-4o)
VITE_OPENAI_MODEL=gpt-4o

# -------------------------
# OPTION 2: Custom AI Gateway (Default)
# -------------------------
# Base URL for the AI Gateway (Default: https://ai-serve.nodove.com)
VITE_AI_GATEWAY_URL=https://ai-serve.nodove.com

# API Key for AI Gateway (optional, depends on gateway configuration)
VITE_AI_GATEWAY_KEY=

# IRL (Internal Reasoning Layer) Feedback Endpoint Path
VITE_IRL_FEEDBACK_PATH=/v1/irl/feedback
